# MIMIC-derived data, real or synthetic, is never committed (PhysioNet
# Credentialed Health Data Use Agreement). Research inputs are built under
# research/foundations/*/data/; synthetic datasets go to ../synthehr-output/.
data/
/output/
synthehr-output/
*.csv
*.parquet
*.feather
*.arrow
*.db
*.duckdb
*.npz
!examples/data/*.csv

# Trained models (a model fitted on patient data can memorise it)
models/
*.pt
*.pkl
*.joblib
*.synthehr

# Python
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.venv/
.pytest_cache/
.ipynb_checkpoints/

# OS, editors, local tooling
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/
*.tmp
